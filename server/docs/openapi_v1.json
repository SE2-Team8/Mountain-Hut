{
	"openapi": "3.0.3",
	"info": {
		"title": "Mountain Hut APIs v1",
		"description": "APIs description for the first version of the Mountain Hut webserver",
		"version": "1.0.0"
	},
	"servers": [
		{ "url": "http://localhost:3001/api", "description": "Development server" }
	],
	"tags": [
		{ "name": "Auth" },
		{ "name": "Users" },
		{ "name": "TimeSlots" },
		{ "name": "Reservations" }
	],
	"paths": {
		"/users/{userId}": {
			"get": {
				"tags": ["Users"],
				"summary": "Get a user by ID",
				"description": "Requires an authenticated user with role EMPLOYEE or WARDEN.",
				"parameters": [
					{ "name": "userId", "in": "path", "required": true, "schema": { "type": "integer" } }
				],
				"responses": {
					"200": {
						"description": "The requested user",
						"content": { "application/json": {
							"schema": { 
								"allOf": [
									{ "$ref": "#/components/schemas/Success" },
									{
										"type": "object",
										"properties": {
											"data": { "$ref": "#/components/schemas/User" }
										}
									}
								]
							} 
						} }
					},
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/auth/login": {
			"post": {
				"tags": ["Auth"],
				"summary": "Log in (create a session)",
				"description": "Authenticates with email and password using the local strategy. Sets a session cookie on success.",
				"requestBody": {
					"required": true,
					"content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
				},
				"responses": {
					"200": {
						"description": "Login successful; session cookie set",
						"content": { "application/json": { "schema":
						{ 
							"allOf": [
									{ "$ref": "#/components/schemas/Success" },
									{
										"type": "object",
										"properties": {
											"data": { "$ref": "#/components/schemas/User" }
										}
									}
								]
						} 
						} }
					},
					"401": { "$ref": "#/components/responses/Unauthorized" }
				}
			}
		},
		"/auth/me": {
			"get": {
				"tags": ["Auth"],
				"summary": "Get the currently logged-in user",
				"security": [{ "cookieAuth": [] }],
				"responses": {
					"200": {
						"description": "The current session's user",
						"content": { "application/json": { "schema":
						{ 
							"allOf": [
									{ "$ref": "#/components/schemas/Success" },
									{
										"type": "object",
										"properties": {
											"data": { "$ref": "#/components/schemas/User" }
										}
									}
								]
						} 
						} }
					},
					"401": { "$ref": "#/components/responses/Unauthorized" }
				}
			}
		},
		"/auth/logout": {
			"post": {
				"tags": ["Auth"],
				"summary": "Log out (destroy the current session)",
				"responses": { "200": {
					"description": "Logout successful",
					"content": { "application/json": { "schema":
						{ 
							"allOf": [
								{ "$ref": "#/components/schemas/Success" },
								{
									"type": "object",
									"properties": {
										"data": { "nullable": true, "example": null }
									}
								}
							]
						} 
						} }
					}
				}
			}
		},
		"/auth/register": {
			"post": {
				"tags": ["Auth"],
				"summary": "Register a new user",
				"requestBody": {
					"required": true,
					"content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequest" } } }
				},
				"responses": {
					"201": {
						"description": "User created",
						"content": { "application/json": { "schema":
						{ 
							"allOf": [
								{ "$ref": "#/components/schemas/Success" },
								{
									"type": "object",
									"properties": {
										"data": { "$ref": "#/components/schemas/User" }
									}
								}
							]
						} 
						} }
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"409": { "description": "Email already registered" }
				}
			}
		},
		"/auth/setup-password": {
			"post": {
				"tags": ["Auth"],
				"summary": "Set the first password for a staff-created hiker",
				"description": "Consumes an emailed setup token and enables the hiker to log in. Setup links expire after 24 hours.",
				"requestBody": {
					"required": true,
					"content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetupPasswordRequest" } } }
				},
				"responses": {
					"200": {
						"description": "Initial password set",
						"content": { "application/json": { "schema": { "$ref": "#/components/schemas/Success" } } }
					},
					"400": { "description": "Setup token is invalid, expired, or already used" },
					"422": { "description": "Invalid token format or password" }
				}
			}
		},
		"/auth/set-new-password": {
			"post": {
				"tags": ["Auth"],
				"summary": "Set new password for a given account",
				"requestBody": {
					"required": true,
					"content": { "application/json": { 
						"schema": { "$ref": "#/components/schemas/SetNewPasswordRequest" } 
						} }
				},
				"responses": {
					"200": {
						"description": "Credentials updated",
						"content": { "application/json": { "schema":
							{ "$ref": "#/components/schemas/Success" }
						}
					} },
					"400": { "$ref": "#/components/responses/BadRequest" },
					"409": { "description": "Token expired" }
				}
			}
		},
		"/auth/forgot-password": {
			"post": {
				"tags": ["Auth"],
				"summary": "Sends a recovery email to set new credentials",
				"requestBody": {
					"required": true,
					"content": { "application/json": { 
						"schema": { "$ref": "#/components/schemas/ForgotPasswordRequest" } 
						} }
				},
				"responses": {
					"200": {
						"description": "Email sent",
						"content": { "application/json": { "schema":
							{ "$ref": "#/components/schemas/Success" }
						}
					} },
					"400": { "$ref": "#/components/responses/BadRequest" }
				}
			}
		},
		"/auth/change-password": {
			"post": {
				"tags": ["Auth"],
				"summary": "Change the password of the logged-in user",
				"security": [{ "cookieAuth": [] }],
				"requestBody": {
					"required": true,
					"content": { "application/json": { 
						"schema": { "$ref": "#/components/schemas/ChangePasswordRequest"}
					}}
				},
				"responses": {
					"200": {
						"description": "Password successfully changed",
						"content": { "application/json": { "schema": {
							"allOf": [
								{ "$ref": "#/components/schemas/Success" },
								{
									"type": "object",
									"properties": {
										"data": { "nullable": true, "example": null }
									}
								}
							]
						}}}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": {
						"description": "The current password is wrong",
						"content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }}}
					},
					"422": {
						"description": "Validation error: a field is missing or not a string or the new password it is equal to the current one",
						"content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }}}
					}
				}
			}
		},
		"/users": {
			"post": {
				"tags": ["Users"],
				"summary": "Create a new user",
				"security": [{ "cookieAuth": [] }],
				"requestBody": {
					"required": true,
					"content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateUserRequest" } } }
				},
				"responses": {
					"201": {
						"description": "User created",
						"content": { "application/json": { "schema":
						{ 
							"allOf": [
								{ "$ref": "#/components/schemas/Success" },
								{
									"type": "object",
									"properties": {
										"data": { "$ref": "#/components/schemas/User" }
									}
								}
							]
						} 
						} }
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" },
					"409": { "description": "Email already registered" }
				}
			}
		},

		"/timeslots": {
			"get": {
				"tags": ["TimeSlots"],
				"summary": "List time slots",
				"description": "Can specify dates 'from' and 'to' to query only inside a time range",
				"parameters": [
					{ "name": "from", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" }, "description": "Lower bound (ISO 8601)" },
					{ "name": "to", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" }, "description": "Upper bound (ISO 8601)" }
				],
				"responses": {
					"200": {
						"description": "A list of time slots",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{ "$ref": "#/components/schemas/Success" },
										{
											"type": "object",
											"properties": {
												"data": { "type": "array", "items": { "$ref": "#/components/schemas/TimeSlot" } }
											}
										}
									]
								}
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" }
				}
			},
			"post": {
				"tags": ["TimeSlots"],
				"summary": "Create a time slot with either the table list or another timeslot id to copy the list from",
				"description": "Requires role EMPLOYEE or WARDEN. Provide exactly one of `tables` (Option A) or `copyFromTimeSlotId` (Option B).",
				"security": [{ "cookieAuth": [] }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"oneOf": [
									{ "$ref": "#/components/schemas/CreateTimeSlotWithTables" },
									{ "$ref": "#/components/schemas/CreateTimeSlotByCopy" }
								]
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "TCreated time slot id",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{ "$ref": "#/components/schemas/Success" },
										{
											"type": "object",
											"properties": {
												"data": { "type": "integer", "minimum": 1 }
											}
										}
									]
								}
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" }
				}
			}
		},
		"/timeslots/availability":{
			"get": {
				"tags": ["TimeSlots"],
				"summary": "Get a time slot by a given date, start time and party size",
				"parameters": [
					{ "name": "start", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" }, "description": "The start datetime (ISO 8601)"},
					{ "name": "partySize", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 1 }, "description": "The number of people to reserve seats"}
				],
				"responses": {
					"200": {
						"description": "The matching time slot",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{ "$ref": "#/components/schemas/Success" },
										{
											"type": "object",
											"properties": {
												"data": { "$ref": "#/components/schemas/TimeSlotAvailable" }
											}
										}
									]
								}
							}
						}
					},
					"404": { "$ref": "#/components/responses/NotFound"}
				}
			}
		},
		"/timeslots/{start}": {
			"get": {
				"tags": ["TimeSlots"],
				"summary": "Get a time slot by its start datetime",
				"parameters": [
					{ "name": "start", "in": "path", "required": true, "schema": { "type": "string", "format": "date-time" }, "description": "The start datetime (ISO 8601)" }
				],
				"responses": {
					"200": {
						"description": "The matching time slot",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{ "$ref": "#/components/schemas/Success" },
										{
											"type": "object",
											"properties": {
												"data": { "$ref": "#/components/schemas/TimeSlot" }
											}
										}
									]
								}
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			}
		},
		"/reservations": {
			"post": {
				"tags": ["Reservations"],
				"summary": "Create a reservation",
				"security": [{ "cookieAuth": [] }],
				"requestBody": {
					"required": true,
					"content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateReservationRequest" } } }
				},
				"responses": {
					"201": {
						"description": "Reservation created, returns reservation id",
						"content": { "application/json": { 
							"schema": {
									"allOf": [
										{ "$ref": "#/components/schemas/Success" },
										{
											"type": "object",
											"properties": {
												"data": { "type": "integer", "minimum": 1 }
											}
										}
									]
								}
						} }
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"404": { "$ref": "#/components/responses/NotFound"},
					"409": { "$ref": "#/components/responses/Conflict" }
				}
			},
			"get": {
				"tags": ["Reservations"],
				"summary": "Get all reservations for a user",
				"security": [{ "cookieAuth": [] }],
				"responses": {
					"200": {
						"description": "Reservations retrieved",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{ "$ref": "#/components/schemas/Success" },
										{
											"type": "object",
											"properties": {
												"data": { "$ref": "#/components/schemas/ReservationsList"}
											}
										}
									]
								}
							}
						}
					},
					"401": { "$ref": "#/components/responses/Unauthorized" }
				}
			}
		},
		"/reservations/{id}": {
			"get": {
				"tags": ["Reservations"],
				"summary": "Get details about one reservation",
				"security": [{ "cookieAuth": [] }],
				"parameters": [
					{ "name": "id", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}, "description": "The reservation id" }
				],
				"responses": {
					"200": {
						"description": "Reservation retrieved",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{ "$ref": "#/components/schemas/Success" },
										{
											"type": "object",
											"properties": {
												"data": { "$ref": "#/components/schemas/ReservationDetails" }
											}
										}
									]
								}
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" },
					"404": { "$ref": "#/components/responses/NotFound" }
				}
			},
			"put": {
				"tags": ["Reservations"],
				"summary": "Update a reservation",
				"security": [{ "cookieAuth": [] }],
				"parameters": [
					{ "name": "id", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}, "description": "The reservation id" }
				],
				"requestBody": {
					"required": true,
					"content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateReservationRequest" } } }
				},
				"responses": {
					"200": {
						"description": "Reservation successfully updated",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/Success" }
							}
						}
					},
					"400": { "$ref": "#/components/responses/BadRequest" },
					"401": { "$ref": "#/components/responses/Unauthorized" },
					"403": { "$ref": "#/components/responses/Forbidden" },
					"404": { "$ref": "#/components/responses/NotFound" },
					"409": { "$ref": "#/components/responses/Conflict" }
				}
			}
		}
	},
	"components": {
		"schemas": {
			"User": {
				"type": "object",
				"required": ["userId", "role", "email", "fullName", "phoneNumber"],
				"properties": {
					"userId": { "type": "integer" },
					"role": { "type": "string", "enum": ["HIKER", "EMPLOYEE", "WARDEN"] },
					"email": { "type": "string", "format": "email" },
					"fullName": { "type": "string" },
					"phoneNumber": { "type": "string" },
					"notes": { "type": "string" },
					"emergencyContact": { "type": "string" },
					"mustChangePassword": { "type": "boolean" }
				}
			},
			"LoginRequest": {
				"type": "object",
				"required": ["email", "password"],
				"properties": {
					"email": { "type": "string", "format": "email" },
					"password": { "type": "string" }
				}
			},
			"RegisterRequest": {
				"type": "object",
				"required": ["email", "password", "fullName", "phone"],
				"properties": {
					"email": { "type": "string", "format": "email" },
					"password": { "type": "string" },
					"fullName": { "type": "string" },
					"phone": { "type": "string" }
				}
			},
			"SetupPasswordRequest": {
				"type": "object",
				"required": ["token", "password"],
				"properties": {
					"token": { "type": "string", "pattern": "^[0-9a-f]{64}$", "writeOnly": true },
					"password": { "type": "string", "minLength": 12, "maxLength": 128, "writeOnly": true }
				}
			},
			"SetNewPasswordRequest": {
				"type": "object",
				"required": ["token", "password"],
				"properties": {
					"token": {"type": "string"},
					"password": {"type": "string"}
				}
			},
			"ForgotPasswordRequest": {
				"type": "object",
				"required": ["email"],
				"properties": {
					"email": {"type": "string", "format": "email"}
				}
			},
			"ChangePasswordRequest": {
				"type": "object",
				"required": ["currentPassword", "newPassword"],
				"properties": {
					"currentPassword": { "type": "string" },
					"newPassword": { "type": "string", "description": "Must be different from currentPassword"}
				}
			},
			"CreateUserRequest": {
				"type": "object",
				"required": ["email", "fullName", "phone"],
				"properties": {
					"email": { "type": "string", "format": "email" },
					"fullName": { "type": "string" },
					"phone": { "type": "string" }
				}
			},
			"Table": {
				"type": "object",
				"required": ["tableNumber", "totalSeats"],
				"properties": {
					"tableNumber": { "type": "integer", "minimum": 1 },
					"totalSeats": { "type": "integer", "minimum": 1 }
				}
			},
			"TableAssignment": {
				"type": "object",
				"required": ["tableId", "tableNumber", "occupiedSeats"],
				"properties": {
					"tableId": { "type": "integer", "minimum": 1 },
					"tableNumber": { "type": "integer", "minimum": 1 },
					"occupiedSeats": { "type": "integer", "minimum": 1 }
				}
			},
			"TableAvailability": {
				"type": "object",
				"required": ["tableNumber", "seatsToTake"],
				"properties": {
					"tableNumber": { "type": "integer", "minimum": 1 },
					"seatsToTake": { "type": "integer", "minimum": 1 }
				}
			},
			"TimeSlot": {
				"type": "object",
				"required": ["timeSlotId", "startDateTime", "endDateTime", "freeSeats"],
				"properties": {
					"timeSlotId": { "type": "integer", "minimum": 1  },
					"startDateTime": { "type": "string", "format": "date-time" },
					"endDateTime": { "type": "string", "format": "date-time" },
					"freeSeats": { "type": "integer", "minimum": 0 }
				}
			},
			"TimeSlotAvailable": {
				"type": "object",
				"required": ["timeSlotId", "available", "freeSeats", "tables"],
				"properties": {
					"timeSlotId": { "type": "integer", "minimum": 1 },
					"available": { "type": "boolean" },
					"freeSeats": { "type": "integer", "minimum": 0},
					"tables": { "type": "array", "minItems": 0, "items": { "$ref": "#/components/schemas/TableAvailability" } }
				}
			},
			"CreateTimeSlotWithTables": {
				"type": "object",
				"required": ["startDateTime", "endDateTime", "tables"],
				"properties": {
					"startDateTime": { "type": "string", "format": "date-time" },
					"endDateTime": { "type": "string", "format": "date-time", "description": "Must be after startDateTime" },
					"tables": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/Table" } }
				}
			},
			"CreateTimeSlotByCopy": {
				"type": "object",
				"required": ["startDateTime", "endDateTime", "copyFromTimeSlotId"],
				"properties": {
					"startDateTime": { "type": "string", "format": "date-time" },
					"endDateTime": { "type": "string", "format": "date-time", "description": "Must be after startDateTime" },
					"copyFromTimeSlotId": { "type": "integer", "minimum": 1 }
				}
			},
			"CreateReservationRequest": {
				"type": "object",
				"required": ["timeSlotId", "partySize", "dietaryRequirements", "userId"],
				"properties": {
					"userId": {"type": "integer", "minimum": 1},
					"timeSlotId": { "type": "integer", "minimum": 1 },
					"partySize": { "type": "integer", "minimum": 1 },
					"dietaryRequirements": {
						"type": "array",
						"description": "Allergies and dietary needs for the party. Use an empty array when there are none.",
						"items": { "$ref": "#/components/schemas/DietaryRequirement" }
					},
					"tmpHikerName": { "type": "string" },
					"tmpHikerPhone": { "type": "string" }
				}
			},
			"DietaryRequirement": {
				"type": "object",
				"required": ["allergies", "description"],
				"properties": {
					"allergies": { "type": "boolean", "description": "True for an allergy, false for a dietary preference or requirement." },
					"description": { "type": "string", "minLength": 1, "description": "A description of the allergy or dietary need." }
				}
			},
			"Reservation": {
				"type": "object",
				"required": ["reservId", "timeSlotId", "userId", "startDateTime", "endDateTime", "partySize", "dietaryRequirements"],
				"properties": {
					"reservId": { "type": "integer", "minimum": 1 },
					"timeSlotId": { "type": "integer" },
					"userId": { "type": "integer", "minimum": 1 },
					"startDateTime": { "type": "string", "format": "date-time" },
					"endDateTime": { "type": "string", "format": "date-time", "description": "Must be after startDateTime" },
					"partySize": { "type": "integer" },
					"dietaryRequirements": {
						"type": "array",
						"description": "Allergies and dietary needs for the party. Use an empty array when there are none.",
						"items": { "$ref": "#/components/schemas/DietaryRequirement" }
					}
				}
			},
			"ReservationDetails": {
				"type": "object",
				"required": ["reservId", "timeSlotId", "startDateTime", "endDateTime", "partySize", "dietaryRequirements", "tableAssigements"],
				"properties": {
					"reservId": { "type": "integer", "minimum": 1 },
					"timeSlotId": { "type": "integer" },
					"startDateTime": { "type": "string", "format": "date-time" },
					"endDateTime": { "type": "string", "format": "date-time", "description": "Must be after startDateTime" },
					"partySize": { "type": "integer" },
					"dietaryRequirements": {
						"type": "array",
						"description": "Allergies and dietary needs for the party. Use an empty array when there are none.",
						"items": { "$ref": "#/components/schemas/DietaryRequirement" }
					},
					"tableAssignments": {
						"type": "array",
						"description": "Distribution of people across tables",
						"items": { "$ref": "#/components/schemas/TableAssignment" }
					}
				}
			},
			"ReservationsList": {
				"type": "array",
				"description": "List of reservations",
				"items": { "$ref": "#/components/schemas/Reservation" }
			},
			"Error": {
				"type": "object",
				"required": ["success", "data", "message"],
				"properties": {
					"success": { "type": "boolean", "enum": [false]},
					"data": { "nullable": true },
					"message": { "type": "string" }
				}
			},
			"Success": {
				"type": "object",
				"required": ["success", "data", "message"],
				"properties": {
					"success": { "type": "boolean", "enum": [true] },
					"data": { "nullable": true },
					"message": { "type": "string" }
				}
			}
		},
		"responses": {
			"BadRequest": {
				"description": "Validation error",
				"content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
			},
			"Unauthorized": {
				"description": "Not authenticated",
				"content": { "application/json": {
					"schema": {
					"allOf": [
						{ "$ref": "#/components/schemas/Error" },
						{
							"type": "object",
							"properties": {
								"message": { "enum": ["Not Authenticated!"] }
							}
						}
						]
					}
				}
			}
			},
			"Forbidden": {
				"description": "Not authorized",
				"content": { "application/json": {
					"schema": { "$ref": "#/components/schemas/Error" }
				}
			}
			},
			"NotFound": {
				"description": "Not found",
				"content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
			},
			"Conflict": {
				"description": "Conflict",
				"content": {
					"application/json": {
						"schema": { "$ref": "#/components/schemas/Error" }
					}
				}
			}
		}
	}
}
